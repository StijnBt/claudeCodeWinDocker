{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "claudeCodeWinDocker: Run",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "start",
                "wt",
                "wsl",
                "--cd",
                "${workspaceFolder}",
                "bash",
                "-ic",
                "bash scripts/claudeCodeAlDevContainer/run-sandbox.sh"
            ],
            "presentation": {
                "reveal": "never",
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "claudeCodeWinDocker: (Re)Build Docker Image",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "start",
                "wt",
                "wsl",
                "--cd",
                "${workspaceFolder}",
                "docker",
                "build",
                "-t",
                "claude-code-sandbox",
                "scripts/claudeCodeAlDevContainer/src"
            ],
            "group": "build",
            "presentation": {
                "reveal": "never",
                "focus": false
            },
            "problemMatcher": []
        }
    ]
}
